# =============================================================================
# FRONTEND (Vite) — bundled into the browser build.
# =============================================================================
# Only public values belong here. Anything prefixed VITE_ is readable by anyone
# who loads the site.
# Copy to .env and fill in from Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://nrpdpoigajouxtncveva.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_ORHp9SkShdAu7zEn-tWolg_PJutP7WO
# Optional: comma-separated admin emails that can access /admin
VITE_ADMIN_EMAILS=admin@email.com
VITE_ADMIN_PASSWORD=Admin123

# =============================================================================
# SERVER-SIDE (Supabase Edge Function secrets) — NEVER prefix these with VITE_
# =============================================================================
# Not read from this file at runtime. Set them on the project with:
#
#   npx supabase secrets set STRIPE_SECRET_KEY=sk_test_xxx
#   npx supabase secrets set STRIPE_WEBHOOK_SECRET=whsec_xxx
#   npx supabase secrets set SITE_URL=http://localhost:5173
#
# Listed here only to document what the Edge Functions expect. Placeholders only
# — never commit a real key.

# Stripe TEST secret key. Must start with sk_test_: create-checkout-session
# refuses to run with a live key, so no real money can ever be charged.
STRIPE_SECRET_KEY=sk_test_your_test_secret_key

# Signing secret for the stripe-webhook function. `stripe listen` prints one for
# local testing; the Stripe dashboard issues one per deployed endpoint.
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# Where Stripe returns the buyer to. No trailing slash.
SITE_URL=http://localhost:5173

# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected
# into Edge Functions automatically — do not set them yourself, and never put the
# service role key in a VITE_ variable.
